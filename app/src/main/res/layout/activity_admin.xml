<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".InterfazAdmin">

    <!-- Sección superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <!-- Imagen Principal -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:src="@drawable/escudo"/>

        <!-- Texto "Bienvenido, señor admin" -->
        <TextView
            android:id="@+id/txtUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido, señor Admin."
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="@color/negroSecundario"
            />
    </LinearLayout>

    <!-- Empuja botones con imágenes -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <!-- Contenedor con imágenes y botones -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="1"
        android:rowCount="2"
        android:layout_gravity="center"
        android:gravity="center">

        <!-- Contenedor con imágenes y botones -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="1">

            <!-- Contenedor "Gestionar Citas" -->
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp">

                <!-- Imagen del Botón -->
                <ImageView
                    android:id="@+id/imgGestionarCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/gestioncitas">
                </ImageView>

                <!-- Botón "Gestionar Citas" -->
                <Button
                    android:id="@+id/btnGestionarCitas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Gestionar Citas"
                    android:textColor="@color/white" />
            </GridLayout>

            <!-- Contenedor "Gestionar Usuarios" -->
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp">

                <!-- Imagen del Botón -->
                <ImageView
                    android:id="@+id/imgGestionarUsuarios"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/gestionusuarios">
                </ImageView>

                <!-- Botón "Gestionar Usuarios" -->
                <Button
                    android:id="@+id/btnGestionarUsuarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Gestionar Usuarios"
                    android:textColor="@color/white" />
            </GridLayout>
        </GridLayout>
    </GridLayout>

    <!-- Espacio vacío para empujar el botón hacia abajo -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón "Salir" -->
    <Button
        android:id="@+id/btnSalir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:backgroundTint="@color/negroSecundario"
        android:text="Salir"
        android:textColor="@color/white"
        />
</LinearLayout>