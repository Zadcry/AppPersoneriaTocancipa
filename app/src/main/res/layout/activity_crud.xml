<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".CRUD">

    <!-- Sección superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <!-- Imagen Principal -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:src="@drawable/escudo"/>

        <!-- Texto "Gestión de..." -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de ..."
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="@color/negroSecundario"
            />

        <!-- Spinner "Tipo de Cuenta" -->
        <Spinner
            android:id="@+id/spTipoCuenta"
            android:background="@drawable/spinner_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:spinnerMode="dropdown"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            />

        <!-- Contenedor con imágenes y botones -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_gravity="center"
            android:gravity="center">

            <!-- Contenedor "Crear"  -->
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp"
                >

                <!-- Imagen del Botón -->
                <ImageView
                    android:id="@+id/imgCrear"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/crear" />

                <!-- Botón "Crear" -->
                <Button
                    android:id="@+id/btnCrear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Crear"
                    android:textColor="@color/white" />
            </GridLayout>

            <!-- Contenedor "Consultar"  -->
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp">

                <!-- Imagen del Botón -->
                <ImageView
                    android:id="@+id/imgConsultar"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/consultar" />

                <!-- Botón "Consultar"  -->
                <Button
                    android:id="@+id/btnConsultar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Consultar"
                    android:textColor="@color/white" />
            </GridLayout>

            <!-- Contenedor "ModificarGrid"  -->
            <GridLayout
                android:id="@+id/gridModificarGrid"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp">

                <!-- Imagen del Botón -->
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/modificar" />

                <!-- Botón "ModificarGrid"  -->
                <Button
                    android:id="@+id/btnModificarGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Modificar"
                    android:textColor="@color/white" />
            </GridLayout>

            <!-- Contenedor "Eliminar"  -->
            <GridLayout
                android:id="@+id/gridEliminar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:columnCount="1"
                android:rowCount="2"
                android:padding="15dp">

                <!-- Imagen del Botón -->
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/eliminar" />

                <!-- Botón "Eliminar"  -->
                <Button
                    android:id="@+id/btnEliminar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:backgroundTint="@color/negroSecundario"
                    android:text="Eliminar"
                    android:textColor="@color/white" />
            </GridLayout>
        </GridLayout>

        <!-- Contenedor "Modificar"  -->
        <GridLayout
            android:id="@+id/gridModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:columnCount="1"
            android:rowCount="2"
            android:padding="15dp">

            <!-- Imagen del Botón -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/modificar" />

            <!-- Botón "Modificar"  -->
            <Button
                android:id="@+id/btnModificar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="fill"
                android:backgroundTint="@color/negroSecundario"
                android:text="Modificar"
                android:textColor="@color/white" />
        </GridLayout>

        <!-- Espacio para empujar el botón hacia abajo -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_weight="1" />

        <!-- Botón "Salir" -->
        <Button
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="@color/negroSecundario"
            android:text="Salir"
            android:textColor="@color/white"
            />


    </LinearLayout>

</LinearLayout>